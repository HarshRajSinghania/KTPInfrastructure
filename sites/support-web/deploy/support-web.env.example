# /etc/ktp/support-web.env  — 0640 root:supportweb. Never commit the real file.
SUPPORT_SESSION_SECRET=change-me
SUPPORT_REPORT_SALT=change-me

# Discord OAuth. See DESIGN.md §G: agree with Sears whether the root site's
# Supabase auth uses THIS application or its own before either ships -- two apps
# means two consent prompts and two grants for the same person.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://support.ktpdod.com/auth/callback

# Relay + routing. Guild 579024206931689482.
SUPPORT_DISCORD_GUILD_ID=579024206931689482
SUPPORT_CHANNEL_SERVER_REPORTS=1534624929729740890
SUPPORT_CHANNEL_PLAYER_REPORTS=1534624984469737583
DISCORD_RELAY_URL=
DISCORD_RELAY_SECRET=

# Comma-separated Discord snowflakes. An allowlist does NOT follow a Discord
# role change -- removing someone here is a deliberate act.
SUPPORT_KTP_ADMIN_IDS=
SUPPORT_ONE3_ADMIN_IDS=

SUPPORT_PUBLIC_JSON=/var/lib/support-web/public.json
SUPPORT_DETAIL_JSON=/var/lib/support-web/detail.json
